# DevSaathi AI — Backend Proxy Environment Variables
# Copy this file to .env and fill in real values.
# .env is excluded from Git by the root .gitignore — never commit it.
#
# ─── SECURITY RULE ──────────────────────────────────────────────────────────
# This file is the ONLY place API keys should exist in this project.
# The frontend never sees these values — they stay on the server process.
# ─────────────────────────────────────────────────────────────────────────────

# Port the backend proxy listens on (default: 3001)
PORT=3001

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: http://localhost:5173,https://devsaathi.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ─── AI Provider Configuration ───────────────────────────────────────────────
# The backend supports any OpenAI-compatible API.
# Popular options:
#   OpenAI:       https://api.openai.com/v1
#   Groq:         https://api.groq.com/openai/v1
#   Together AI:  https://api.together.xyz/v1
#   Anyscale:     https://api.endpoints.anyscale.com/v1
#
# Leave AI_API_URL empty to run in DEMO MODE (no real AI calls).

# API endpoint (OpenAI-compatible /chat/completions)
AI_API_URL=

# Your secret API key — keep this private, rotate if ever exposed
AI_API_KEY=

# Model to use (default: gpt-4o-mini — cheap and fast for a hackathon)
AI_MODEL=gpt-4o-mini

# Request timeout in milliseconds (default: 30000 = 30 seconds)
AI_TIMEOUT_MS=30000
