# DevSaathi AI — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is excluded from Git by .gitignore — never commit it.
#
# ─── IMPORTANT SECURITY NOTE ─────────────────────────────────────────────────
# DO NOT put API keys here. Any VITE_* variable is compiled into the browser
# bundle and is readable by anyone who opens the JavaScript source.
#
# API keys belong ONLY in server/.env (the backend proxy).
# See server/.env.example for backend configuration.
# ─────────────────────────────────────────────────────────────────────────────

# URL of the DevSaathi backend proxy (default: http://localhost:3001)
# Change this when deploying the backend to a server.
VITE_API_BASE_URL=http://localhost:3001
